# Copy to .env and set a unique random bearer token before production deployment.
NEXO_ENV=development
NEXO_API_TOKEN=
NEXO_API_HOST=127.0.0.1
NEXO_API_PORT=8000
NEXO_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Private/local Ollama endpoint. Never expose this port publicly.
OLLAMA_HOST=http://127.0.0.1:11434
NEXO_PROVIDER_TYPE=ollama
NEXO_MODEL_ANALYST=qwen2.5-coder:7b
NEXO_MODEL_STRATEGIST=qwen2.5-coder:7b
NEXO_MODEL_EXECUTOR=qwen2.5-coder:7b
NEXO_MODEL_EVALUATOR=qwen2.5-coder:7b
# Optional; defaults to NEXO_MODEL_ANALYST.
# NEXO_MODEL_RESEARCHER=qwen2.5-coder:7b
NEXO_EMBEDDING_MODEL=nomic-embed-text
# Optional fallback is used only when installed and primary model is unavailable.
# NEXO_OLLAMA_FALLBACK_MODEL=qwen2.5-coder:3b
NEXO_OLLAMA_TIMEOUT=180
NEXO_OLLAMA_RETRIES=2

NEXO_SESSION_TIMEOUT=300
NEXO_MAX_TOOL_EXECUTIONS=20
NEXO_MAX_LLM_CALLS=30
NEXO_MAX_ITERATIONS=5
NEXO_MAX_REPLANNING=2
NEXO_DB_PATH=./nexo_data.db
NEXO_MEMORY_PATH=./nexo_data_db
# Emergency stop: set true, or point to a marker file managed by the operator.
NEXO_EMERGENCY_STOP=false
# NEXO_EMERGENCY_STOP_FILE=/run/nexo/emergency-stop
